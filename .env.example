# Copy to .env. docker compose and the Makefile read this file.

# --- Telegram ---
# Use your personal dev bot from @BotFather, never the production bot. A webhook
# registered with a shared token takes delivery away from every other deployment.
# The placeholder lets the REST API run without a bot (bot init fails, API still works).
TELEGRAM_BOT_TOKEN=000000:dev-placeholder
# Public HTTPS URL that Telegram posts updates to (<PUBLIC_BASE_URL>/webhook).
# Locally: `make tunnel` prints it. Leave empty to skip webhook registration.
PUBLIC_BASE_URL=
# ngrok auth token for `make tunnel` (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# --- Database ---
# docker compose sets this for the backend container. Only needed when running uvicorn
# on the host: postgresql://nest:nest@localhost:5432/nest_db. Production uses Neon.
DATABASE_URL=

# --- Dashboard auth (docs/api-v1.md) ---
# docker compose sets these for the backend container; values below are for a host run.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=nest-api
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Planned (not read yet) ---
# Fernet key that encrypts per-workspace bot tokens (B1). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Error reporting (D3)
SENTRY_DSN=

# --- v2 / off by default ---
# Natural-language /add_task via Gemini. PRD v1 creates tasks from the dashboard.
AI_TASK_PARSING_ENABLED=false
GEMINI_API_KEY=

# --- Local overrides (optional) ---
# POSTGRES_PORT=5432
# API_PORT=8000
# DASHBOARD_PORT=3000
# NGROK_INSPECT_PORT=4040
# DASHBOARD_DIR=../nest-dashboard
