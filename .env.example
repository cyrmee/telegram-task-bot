# Copy to .env. docker compose and the Makefile read this file.

# --- Telegram ---
# Each workspace connects its own BotFather bot from the dashboard (PUT /workspaces/{id}/bot).
# Locally, use personal dev bots, never the production bot: setWebhook with a shared token
# takes delivery away from every other deployment of that bot.
# Fernet key that encrypts the stored bot tokens. Required to connect a bot. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every stored token unreadable (those bots must be reconnected).
TOKEN_ENCRYPTION_KEY=
# Public HTTPS origin Telegram posts updates to (<PUBLIC_BASE_URL>/telegram/<bot id>).
# Locally: `make tunnel` (or `ngrok http 8000`) prints it. Empty = no webhooks are registered.
# On startup every connected bot's webhook is re-pointed here if it changed.
PUBLIC_BASE_URL=
# ngrok auth token for `make tunnel` (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# --- Database ---
# docker compose sets this for the backend container. Only needed when running uvicorn
# on the host: postgresql://nest:nest@localhost:5432/nest_db. Production uses Neon.
DATABASE_URL=

# --- Dashboard auth (docs/api-v1.md) ---
# docker compose sets these for the backend container; values below are for a host run.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=nest-api
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Planned (not read yet) ---
# Error reporting (D3)
SENTRY_DSN=

# --- Legacy single bot (app/bot/legacy), off by default; removed in B6 ---
LEGACY_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=

# --- v2 / off by default ---
# Natural-language /add_task via Gemini. PRD v1 creates tasks from the dashboard.
AI_TASK_PARSING_ENABLED=false
GEMINI_API_KEY=

# --- Local overrides (optional) ---
# POSTGRES_PORT=5432
# API_PORT=8000
# DASHBOARD_PORT=3000
# NGROK_INSPECT_PORT=4040
# DASHBOARD_DIR=../nest-dashboard
